#!/bin/bash
#
# Pre-commit hook for automatic Quarto notebook rendering
# This hook automatically converts and renders Jupyter notebooks when they are committed
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Checking for changes...${NC}"

# Auto-fix linting issues with Ruff (src/ and tests/ only)
echo -e "${YELLOW}🔧 Running Ruff auto-fix...${NC}"
if ! uv run ruff check --fix src/ tests/ 2>/dev/null; then
    echo -e "${RED}❌ Ruff check failed${NC}"
    echo -e "${RED}   Fix the errors above or use: git commit --no-verify${NC}"
    exit 1
fi

if ! uv run ruff format src/ tests/ 2>/dev/null; then
    echo -e "${RED}❌ Ruff format failed${NC}"
    echo -e "${RED}   Fix the errors above or use: git commit --no-verify${NC}"
    exit 1
fi

# Re-add any files that were auto-fixed
git diff --name-only | grep -E '^(src/|tests/)' | xargs -r git add 2>/dev/null || true

echo -e "${GREEN}✅ Ruff auto-fix completed${NC}"

# Check for Python source file changes (docstring validation)
python_changed=$(git diff --cached --name-only --diff-filter=ACM | grep -E "^src/.*\.py$")

if [ -n "$python_changed" ]; then
    echo -e "${YELLOW}🐍 Validating docstrings for changed Python files...${NC}"

    # Run docstring validation
    if ! uv run python scripts/validate_docstrings.py; then
        echo -e "${RED}❌ Docstring validation failed${NC}"
        echo -e "${RED}   Add docstrings to modified functions or use: git commit --no-verify${NC}"
        exit 1
    fi

    echo -e "${GREEN}✅ Docstring validation passed${NC}"
fi

# Get list of staged .ipynb files in quarto_example directory only
staged_notebooks=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ipynb$' | grep -E '^examples/quarto_example/')

if [ -z "$staged_notebooks" ]; then
    echo -e "${GREEN}✅ No notebook changes detected in examples/quarto_example/ directory${NC}"
    exit 0
fi

echo -e "${YELLOW}📔 Found notebook changes:${NC}"
echo "$staged_notebooks" | sed 's/^/  - /'

# Check if quarto is available
if ! command -v quarto &> /dev/null; then
    echo -e "${RED}❌ Error: quarto command not found${NC}"
    echo -e "${RED}   Please install Quarto CLI or add it to PATH${NC}"
    echo -e "${RED}   You can skip this hook with: git commit --no-verify${NC}"
    exit 1
fi

# Process each notebook
success=true
for notebook in $staged_notebooks; do
    echo -e "${BLUE}🔄 Processing: $notebook${NC}"

    # Get the directory and base name
    notebook_dir=$(dirname "$notebook")
    notebook_base=$(basename "$notebook" .ipynb)

    # Convert to QMD
    echo -e "  📝 Converting to QMD..."
    if ! uv run quarto convert "$notebook" 2>/dev/null; then
        echo -e "${RED}❌ Failed to convert $notebook to QMD${NC}"
        success=false
        continue
    fi

    # Render to PDF
    echo -e "  📄 Rendering to PDF..."
    uv run quarto render "$notebook" --execute --to pdf --quiet 2>/dev/null
    # Check if PDF was actually created (quarto may return exit code 1 due to warnings)
    pdf_file="${notebook_dir}/${notebook_base}.pdf"
    if [ ! -f "$pdf_file" ]; then
        echo -e "${RED}❌ Failed to render $notebook to PDF${NC}"
        success=false
        continue
    fi

    # Render to HTML
    echo -e "  🌐 Rendering to HTML..."
    uv run quarto render "$notebook" --execute --to html --quiet 2>/dev/null
    # Check if HTML was actually created (quarto may return exit code 1 due to warnings)
    html_file="${notebook_dir}/${notebook_base}.html"
    if [ ! -f "$html_file" ]; then
        echo -e "${RED}❌ Failed to render $notebook to HTML${NC}"
        success=false
        continue
    fi

    # Add generated files to staging area
    qmd_file="${notebook_dir}/${notebook_base}.qmd"

    echo -e "  ➕ Adding generated files to staging area..."

    # Add files if they exist
    if [ -f "$qmd_file" ]; then
        git add "$qmd_file"
        echo -e "    ✅ Added: $qmd_file"
    fi

    if [ -f "$pdf_file" ]; then
        git add "$pdf_file"
        echo -e "    ✅ Added: $pdf_file"
    fi

    if [ -f "$html_file" ]; then
        git add "$html_file"
        echo -e "    ✅ Added: $html_file"
    fi

    # Add any generated files directory (e.g., for images)
    files_dir="${notebook_dir}/${notebook_base}_files"
    if [ -d "$files_dir" ]; then
        git add "$files_dir"
        echo -e "    ✅ Added: $files_dir/"
    fi

    echo -e "${GREEN}✅ Successfully processed: $notebook${NC}"
done

if [ "$success" = false ]; then
    echo -e "${RED}❌ Some notebooks failed to process${NC}"
    echo -e "${RED}   Fix the errors above or use: git commit --no-verify${NC}"
    exit 1
fi

echo -e "${GREEN}🎉 All notebooks processed successfully!${NC}"
echo -e "${GREEN}   Generated files have been added to this commit${NC}"

exit 0